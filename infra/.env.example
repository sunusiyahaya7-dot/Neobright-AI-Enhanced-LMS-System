# Docker Compose Environment Variables
# Copy this to .env and fill in your values

# ============================================================================
# Database Configuration
# ============================================================================
DB_NAME=moodle
DB_USER=moodle
DB_PASSWORD=moodle_password
DB_ROOT_PASSWORD=root_password

# ============================================================================
# Moodle Configuration
# ============================================================================
MOODLE_PORT=8080
MOODLE_TOKEN=moodle_api_token_here
MOODLE_BASE_URL=http://localhost:8080

# ============================================================================
# Flask AI Backend Configuration
# ============================================================================
BACKEND_PORT=5000
FLASK_ENV=development

# OpenAI Configuration
OPENAI_API_KEY=openai_api_key_here
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.6
AI_MAX_TOKENS=500

# Backend URL (for external access, used in file proxy links)
BACKEND_URL=http://localhost:5000

# Firebase Service Account Path (inside container)
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json
